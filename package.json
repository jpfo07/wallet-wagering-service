{
  "name": "wallet-wagering-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start:api": "bun run src/entrypoints/api.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=30000",
    "test:unit": "bun test --timeout=30000 test/unit",
    "test:integration": "bun test --timeout=30000 test/integration",
    "test:concurrency": "bun test --timeout=60000 test/concurrency",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "migration:up": "bun run src/entrypoints/migrate.ts up",
    "migration:down": "bun run src/entrypoints/migrate.ts down",
    "migration:create": "bun run src/entrypoints/migrate.ts create",
    "compat:matrix": "bash scripts/bun-compat-matrix.sh",
    "compose:smoke": "bash scripts/compose-smoke.sh",
    "image:migrations-check": "bash scripts/image-migrations-check.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "decimal.js": "10.6.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tinyglobby": "0.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/bun": "1.3.14",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
