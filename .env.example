# Copie para .env para rodar processos fora do compose (o Bun carrega .env automaticamente).

# Identificação da instância (default: hostname do container)
# INSTANCE_ID=
HTTP_PORT=3000
# Retry-After (segundos) do 503 por falha transitória de infraestrutura
HTTP_RETRY_AFTER_SECONDS=1

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wallet
DATABASE_USER=wallet
DATABASE_PASSWORD=wallet
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Encerra sessão parada com transação aberta (solta os locks de um publisher travado)
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Retry de erros transitórios (lock timeout, deadlock, conexão): tentativas totais e backoff
DATABASE_TRANSIENT_RETRY_ATTEMPTS=3
DATABASE_TRANSIENT_RETRY_BASE_MS=50
DATABASE_TRANSIENT_RETRY_MAX_MS=400

# PENDING_REFERENCE: backoff exponencial (1s → 60s) e expiração em 15 min
PENDING_REFERENCE_BACKOFF_BASE_MS=1000
PENDING_REFERENCE_BACKOFF_MAX_MS=60000
PENDING_REFERENCE_TTL_MS=900000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=500
PENDING_REFERENCE_ERROR_PAUSE_BASE_MS=500
PENDING_REFERENCE_ERROR_PAUSE_MAX_MS=30000

# Publicador da outbox (ordem por wallet; retry sem limite de tentativas)
OUTBOX_BATCH_AGGREGATES=50
OUTBOX_MAX_EVENTS_PER_AGGREGATE=10
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_RETRY_BACKOFF_BASE_MS=1000
OUTBOX_RETRY_BACKOFF_MAX_MS=60000
# Deve ser menor que DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS (validado no boot)
OUTBOX_SQS_REQUEST_TIMEOUT_MS=5000
OUTBOX_ERROR_PAUSE_BASE_MS=500
OUTBOX_ERROR_PAUSE_MAX_MS=30000

# SQS (LocalStack 4.14.0). Sem SQS_ENDPOINT, o SDK fala com a AWS real.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=60

# Consumidor SQS (o boot recusa VisibilityTimeout menor que o pior caso de processamento)
SQS_CONSUMER_CONCURRENCY=4
SQS_WAIT_TIME_SECONDS=5
SQS_RETRY_BACKOFF_BASE_MS=2000
SQS_RETRY_BACKOFF_MAX_MS=60000
SQS_SHUTDOWN_DRAIN_MS=8000
SQS_PROCESSING_MARGIN_MS=10000
SQS_DATABASE_PROBE_TIMEOUT_MS=2000
SQS_DATABASE_PROBE_FRESHNESS_MS=2000
SQS_DATABASE_PAUSE_BASE_MS=1000
SQS_DATABASE_PAUSE_MAX_MS=30000

# Stack de testes (docker-compose.test.yml) — usadas por test/support
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=55432
TEST_DATABASE_USER=wallet
TEST_DATABASE_PASSWORD=wallet
TEST_SQS_ENDPOINT=http://localhost:54566
